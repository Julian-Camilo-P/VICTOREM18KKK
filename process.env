// supabaseClientAdmin.js (Este archivo debe estar en tu backend de Railway)

const { createClient } = require('@supabase/supabase-js');

// 1. EL CÓDIGO LEE LAS VARIABLES DE ENTORNO DE RAILWAY
const supabaseUrl = process.env.SUPABASE_URL;
const supabaseServiceRoleKey = process.env.SUPABASE_SERVICE_ROLE_KEY;

if (!supabaseUrl || !supabaseServiceRoleKey) {
    console.error("ERROR: Las variables de entorno de Supabase (URL o SERVICE_ROLE_KEY) no están cargadas. Revisa la configuración en Railway.");
    // Terminar la aplicación si no están presentes (por seguridad)
    process.exit(1); 
}

// 2. CREA EL CLIENTE CON PERMISOS DE ADMINISTRADOR
const supabaseAdmin = createClient(supabaseUrl, supabaseServiceRoleKey, {
    auth: {
        autoRefreshToken: false,
        persistSession: false // No necesitamos persistir sesión en el servidor
    }
});

module.exports = supabaseAdmin;